#!/usr/bin/env bash
# Better Git: small, opinionated shortcuts around git and the GitHub CLI.
set -euo pipefail

PROGRAM="bgt"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/bgt"
CONFIG_FILE="$CONFIG_DIR/credentials"

die() { printf '%s\n' "${PROGRAM}: $*" >&2; exit 1; }
info() { printf '%s\n' "${PROGRAM}: $*"; }
need() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required. $2"; }

usage() {
  cat <<'EOF'
Usage: bgt <command> [arguments]

Everyday commands:
  create <name> [--private|--public] [--description TEXT]
      Create a GitHub repository, initialise this folder, add README, commit and push.
  clone <owner/repo> [folder]
      Clone a GitHub repository using bgt's authenticated HTTPS transport.
  save <message> [files...]
      Stage the given files (or everything), commit, then push the current branch.
  sync
      Pull with rebase and push the current branch.
  pr [title] [--draft]
      Create a pull request for the current branch (or open GitHub's interactive flow).
  open
      Open the current repository in the browser.
  status
      Show compact Git status plus GitHub pull-request status.
  doctor
      Check Git, GitHub authentication and recommended configuration.

Setup:
  bgt auth
      Browser login (uses gh temporarily); bgt auth set accepts a token manually.

Run 'bgt <command> --help' where applicable.  Secrets are never accepted as command
arguments: bgt stores them only in ~/.config/bgt/credentials (mode 0600).
EOF
}

repo_root() { git rev-parse --show-toplevel 2>/dev/null || die "not inside a Git repository"; }
with_git_auth() {
  load_credentials
  local basic
  basic=$(printf '%s:%s' "$BGT_USERNAME" "$BGT_TOKEN" | base64 | tr -d '\n')
  GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraHeader \
    GIT_CONFIG_VALUE_0="Authorization: Basic $basic" "$@"
}
load_credentials() {
  [[ -r $CONFIG_FILE ]] || die "not authenticated. Run 'bgt auth set'."
  BGT_USERNAME=$(sed -n 's/^username=//p' "$CONFIG_FILE" | head -n1)
  BGT_TOKEN=$(sed -n 's/^token=//p' "$CONFIG_FILE" | head -n1)
  [[ -n $BGT_USERNAME && -n $BGT_TOKEN ]] || die "invalid bgt credentials file"
}
save_credentials() {
  local username=$1 token=$2
  [[ -n $username && -n $token ]] || die 'username and token are required'
  ( umask 077; mkdir -p "$CONFIG_DIR"; printf 'username=%s\ntoken=%s\n' "$username" "$token" > "$CONFIG_FILE" )
  info "credentials saved in $CONFIG_FILE"
}
cmd_auth() {
  local username token
  case "${1:-browser}" in
    browser)
      if ! { (($# == 0)) || { (($# == 1)) && [[ $1 == browser ]]; }; }; then
        die 'Usage: bgt auth [browser|set]'
      fi
      need gh "Browser login requires GitHub CLI; install gh or use 'bgt auth set'."
      gh auth login -h github.com -p https -w --skip-ssh-key
      username=$(gh api user --jq .login)
      token=$(gh auth token -h github.com)
      save_credentials "$username" "$token"
      gh auth logout -h github.com -u "$username" >/dev/null 2>&1 || true
      info "Browser login imported into bgt; no Git credential helper was configured."
      ;;
    set)
      (($# == 1)) || die 'Usage: bgt auth set'
  read -r -p 'GitHub username: ' username
  read -r -s -p 'GitHub token: ' token; printf '\n'
      save_credentials "$username" "$token"
      ;;
    *) die 'Usage: bgt auth [browser|set]' ;;
  esac
}
ensure_identity() {
  if ! git config user.name >/dev/null 2>&1 || ! git config user.email >/dev/null 2>&1; then
    die "Git author identity is missing. Configure it declaratively in Home Manager."
  fi
}


cmd_create() {
  local name='' visibility='--private' description='' arg
  while (($#)); do
    arg=$1; shift
    case "$arg" in
      --public|--private) visibility=$arg ;;
      --description)
        (($#)) || die "--description needs text"
        description=$1; shift ;;
      -h|--help) printf '%s\n' 'Usage: bgt create <name> [--private|--public] [--description TEXT]'; return ;;
      -*) die "unknown option: $arg" ;;
      *) [[ -z $name ]] || die "only one repository name is allowed"; name=$arg ;;
    esac
  done
  [[ -n $name ]] || die "repository name is required"
  load_credentials
  need git "Install Git (nixpkgs#git) first."
  ensure_identity
  [[ ! -e .git ]] || die "this folder is already a Git repository; create an empty folder first"
  [[ -z "$(find . -mindepth 1 -maxdepth 1 -print -quit)" ]] || die "create must run in an empty folder"

  git init -b main
  printf '# %s\n' "$name" > README.md
  git add README.md
  git commit -m 'Initial commit'
  local private=true; [[ $visibility == --public ]] && private=false
  description=${description//\\/\\\\}; description=${description//\"/\\\"}
  curl -fsS -H "Authorization: Bearer $BGT_TOKEN" -H 'Accept: application/vnd.github+json' \
    -d "{\"name\":\"$name\",\"description\":\"$description\",\"private\":$private}" https://api.github.com/user/repos >/dev/null
  git remote add origin "https://github.com/$BGT_USERNAME/$name.git"
  with_git_auth git push -u origin HEAD
  info "Created and pushed $BGT_USERNAME/$name."
}

cmd_clone() {
  need git "Install Git (nixpkgs#git) first."
  (($# >= 1 && $# <= 2)) || die "Usage: bgt clone <owner/repo> [folder]"
  local repository=$1 folder=${2:-}
  local url="https://github.com/$repository.git"
  if [[ -n $folder ]]; then with_git_auth git clone "$url" "$folder"; else with_git_auth git clone "$url"; fi
}

cmd_save() {
  repo_root >/dev/null
  ensure_identity
  (($# >= 1)) || die "Usage: bgt save <message> [files...]"
  local message=$1; shift
  if (($#)); then git add -- "$@"; else git add -A; fi
  git diff --cached --quiet && die "nothing staged to commit"
  git commit -m "$message"
  with_git_auth git push -u origin HEAD
}

cmd_sync() {
  repo_root >/dev/null
  with_git_auth git pull --rebase
  with_git_auth git push
}

cmd_pr() {
  local draft=false title=''
  while (($#)); do
    case "$1" in
      --draft) draft=true ;;
      -h|--help) printf '%s\n' 'Usage: bgt pr [title] [--draft]'; return ;;
      -*) die "unknown option: $1" ;;
      *) [[ -z $title ]] || die "only one title is allowed"; title=$1 ;;
    esac
    shift
  done
  repo_root >/dev/null
  load_credentials
  local branch repo
  branch=$(git branch --show-current)
  repo=$(git remote get-url origin | sed -E 's#.*github.com[:/]([^/]+/[^/]+)(\.git)?#\1#')
  [[ -n $title ]] || title="$branch"
  curl -fsS -H "Authorization: Bearer $BGT_TOKEN" -H 'Accept: application/vnd.github+json' \
    -d "{\"title\":\"$title\",\"head\":\"$branch\",\"base\":\"main\",\"draft\":$draft}" \
    "https://api.github.com/repos/$repo/pulls"
}

cmd_open() { repo_root >/dev/null; xdg-open "$(git remote get-url origin | sed 's|\.git$||')"; }
cmd_status() { repo_root >/dev/null; git status -sb; }

cmd_doctor() {
  need git "Install Git (nixpkgs#git) first."
  git --version
  load_credentials
  info "bgt authentication: OK; no Git credential helper is used."
}

case "${1:-help}" in
  auth) shift; cmd_auth "$@" ;;
  help|-h|--help) usage ;;
  create) shift; cmd_create "$@" ;;
  clone) shift; cmd_clone "$@" ;;
  save) shift; cmd_save "$@" ;;
  sync) shift; (($# == 0)) || die 'Usage: bgt sync'; cmd_sync ;;
  pr) shift; cmd_pr "$@" ;;
  open) shift; (($# == 0)) || die 'Usage: bgt open'; cmd_open ;;
  status) shift; (($# == 0)) || die 'Usage: bgt status'; cmd_status ;;
  doctor) shift; (($# == 0)) || die 'Usage: bgt doctor'; cmd_doctor ;;
  *) die "unknown command '$1' (run 'bgt help')" ;;
esac
